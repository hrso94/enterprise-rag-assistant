# ─── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Models (optional) ───────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=1000

# ─── Retrieval (optional) ─────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
# Minimum cosine similarity score to include a result. Lower to widen recall,
# raise to reduce hallucination risk on out-of-corpus queries.
SIMILARITY_THRESHOLD=0.55
# Hybrid search weight: 1.0 = pure vector, 0.0 = pure BM25.
# 0.7 works well for general technical documentation.
HYBRID_ALPHA=0.7

# ─── Chunking (optional) ─────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ─── Storage (optional) ──────────────────────────────────────────────────────
# json   — file-based, suitable for local dev and testing (<1k chunks)
# qdrant — production-grade vector DB, requires QDRANT_URL below
VECTOR_STORE_TYPE=json
VECTOR_DB_PATH=./data/vectors.json
MAX_FILE_SIZE_MB=10

# ─── Qdrant (required if VECTOR_STORE_TYPE=qdrant) ───────────────────────────
# Local:  docker run -p 6333:6333 qdrant/qdrant
# Cloud:  https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise-rag

# ─── API resilience (optional) ───────────────────────────────────────────────
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_MS=1000

# ─── Logging (optional) ──────────────────────────────────────────────────────
# debug | info | warn | error  (default: info)
LOG_LEVEL=info
